    {
      "name": "Cuestionario (HU-02)",
      "description": "Reactivos, ciclo de intentos, autosave de respuestas y cálculo del perfil. Requiere haber corrido antes un request de Auth que deja {{token}}.",
      "item": [
        {
          "name": "Reactivos activos (GET /questions)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('30 reactivos activos', () => {",
                  "  pm.expect(pm.response.json().questions).to.have.lengthOf(30);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('questionId', pm.response.json().questions[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "questions"
              ]
            }
          }
        },
        {
          "name": "Iniciar o retomar intento (POST /attempts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve intento en curso, reactivos y avance', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.attempt.status).to.eql('in_progress');",
                  "  pm.expect(body.questions).to.have.lengthOf(30);",
                  "  pm.expect(body.progress.total).to.eql(30);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('attemptId', pm.response.json().attempt.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attempts"
              ]
            }
          }
        },
        {
          "name": "Autosave de una respuesta (PATCH /attempts/:id/answers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('guarda la respuesta y actualiza el avance', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.answer.value).to.eql(4);",
                  "  pm.expect(body.progress.answered).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": {{questionId}},\n  \"value\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}/answers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attempts",
                "{{attemptId}}",
                "answers"
              ]
            }
