# Copiar a server/.env y ajustar los valores. NUNCA commitear el .env real.

# Servidor
PORT=3000

# Base de datos (valores por defecto de docker-compose.yml)
PGHOST=localhost
PGPORT=5432
PGUSER=brujula
PGPASSWORD=brujula_dev
PGDATABASE=brujula_vocacional
DATABASE_URL=postgres://brujula:brujula_dev@localhost:5432/brujula_vocacional

# Autenticación
JWT_SECRET=cambiar-por-un-secreto-seguro
JWT_EXPIRES_IN=24h
